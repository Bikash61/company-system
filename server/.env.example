# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/austere-analytics

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Transactional Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Austere-Analytics <hello@austere-analytics.com>
ADMIN_EMAIL=admin@austere-analytics.com

# ─── Python AI Service ───────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
